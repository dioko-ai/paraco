{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paraco.dev/schemas/paraco-manifest-v1.json",
  "title": "Paraco application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "entrypoint", "capabilities"],
  "properties": {
    "schemaVersion": { "description": "Optional for compatibility; when present it must be 1.", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "entrypoint": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["ai"] }
    }
  }
}
