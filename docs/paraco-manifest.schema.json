{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paraco.dev/schemas/paraco-manifest-v1.json",
  "title": "Paraco application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "entrypoint", "capabilities"],
  "properties": {
    "schemaVersion": { "description": "Optional for compatibility; when present it must be 1.", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
    "entrypoint": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["ai", "storage", "tasks", "system"] }
    },
    "targets": {
      "description": "Optional deployment targets. Defaults to local and cloudflare, except manifests requesting tasks or system default to local.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["local", "cloudflare"] }
    },
    "outputs": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mediaType"],
        "properties": {
          "mediaType": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
          "schema": {}
        }
      }
    }
  }
}
